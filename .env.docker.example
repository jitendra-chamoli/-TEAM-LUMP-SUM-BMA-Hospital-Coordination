# Settings for `docker compose up`. Copy to `.env` in this folder and change the two secrets.
# (.env is git-ignored; never commit it.)

# Required
MYSQL_ROOT_PASSWORD=change_me_db_password
JWT_SECRET=change_me_to_a_long_random_string

# Optional
DB_NAME=hospital_coordination
MYSQL_PORT=3307
TZ=Asia/Kolkata

# Where the browser reaches the app. Change these if you serve it from another host/domain.
CLIENT_URL=http://localhost:3000
USER_APP_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:5000
PUBLIC_ORCHESTRATOR_URL=http://localhost:5001

# Dispatch
# Road routes and ETAs. With MAPBOX_TOKEN set, routes use live traffic (Mapbox
# driving-traffic; the free tier covers 100,000 requests a month). Without it, routes
# come from OSRM: real roads, no traffic, no key. OSRM_URL defaults to the public
# demo server, which is for development only -- run your own for production.
# ROUTING_PROVIDER=none skips both and uses a straight-line estimate.
MAPBOX_TOKEN=
OSRM_URL=
ROUTING_PROVIDER=

# Shared by the server and the demo simulator. Set a long random string; the demo
# ambulances don't move without it.
TELEMETRY_TOKEN=
# Demo simulator speed (km/h) and how much faster than real time it runs
SIM_SPEED_KMH=50
SIM_SPEEDUP=4
DISPATCH_FANOUT=5
DISPATCH_DEADLINE_SECONDS=45
DISPATCH_CLAIM_WINDOW_MS=2000
# Drivers accept jobs. The nearest AMBULANCE_OFFER_FANOUT drivers on shift are offered a
# job at once and have AMBULANCE_OFFER_SECONDS to accept; then the next nearest are asked,
# up to AMBULANCE_OFFER_ROUNDS rounds before the caller is told to call 108.
AMBULANCE_OFFER_FANOUT=3
AMBULANCE_OFFER_SECONDS=20
AMBULANCE_OFFER_ROUNDS=3
SIM_SPEED_KMH=50
SIM_SPEEDUP=4
USE_DEMO_AMBULANCES=true
GPS_STALE_MINUTES=10

# Public (citizen) app
PUBLIC_REQUESTS_PER_DAY=5
PUBLIC_REQUESTS_PER_IP_PER_DAY=15
EMERGENCY_NUMBER=108
